  "github_sync": {
    "repo": "priyanshbajpai/FOOD-INTELLIGENCE-OS",
    "branch": "main",
    "tracked_durable_paths": [
      "MARCHA_SOURCE_BANK.md",
      "FMCG_OS_THREAD_STARTER.md",
      "sources/",
      "outputs/00-marcha-system/",
      "work/brand-assets/BRAND_TYPE_SYSTEM.md",
