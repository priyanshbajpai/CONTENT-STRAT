      "local_cache": "work/model-cache/t5-recipe-generation"
    }
  },
  "candidate_sources": {
    "foodsky": {
      "github": "https://github.com/LanceZPF/FoodSky",
      "zenodo": "https://zenodo.org/records/14892842",
      "paper": "https://arxiv.org/abs/2406.10261",
      "uses": ["food-domain LLM/corpus reference", "food Q&A benchmark inspiration"],
      "status": "candidate; review licensing/access before commercial use"
    },
    "global_gastronomic_culinary_dataset": {
      "github": "https://github.com/IS2AI/Global-Gastronomic-Culinary-Dataset",
