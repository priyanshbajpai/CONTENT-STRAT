{
  "purpose": "Durable source registry for FMCG-OS and Marcha",
  "canonical_sources": {
    "marcha_source_bank": "MARCHA_SOURCE_BANK.md",
    "thread_starter": "FMCG_OS_THREAD_STARTER.md",
    "marcha_system": "outputs/00-marcha-system",
    "source_library": "sources"
  },
  "active_local_models": {
    "epicure": {
      "status": "live",
      "uses": ["ingredient pairings", "substitutions", "chemistry neighbours", "cuisine shifts"],
      "local_cache": "work/model-cache"
    },
    "recipebert": {
      "status": "live",
      "uses": ["recipe-space plausibility", "concept similarity", "variant ranking"],
      "local_environment": "work/flavorforge-venv"
    },
    "t5_recipe_generation": {
      "status": "live",
